{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fth-skills.dev/contracts/system-design-handoff/1.0",
  "title": "System Design Handoff Envelope v1",
  "type": "object",
  "required": [
    "contract_version",
    "state_patch",
    "handoff_summary",
    "blocking_questions",
    "remaining_risks",
    "next_recommended_capability",
    "validation_notes"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "state_patch": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "problem": {
          "type": "object",
          "required": [
            "summary",
            "scope",
            "actors",
            "source",
            "confidence"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "actors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "$ref": "#/$defs/confidence"
            }
          }
        },
        "functional_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fr"
          }
        },
        "non_functional_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nfr"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asm"
          }
        },
        "estimates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/est"
          }
        },
        "architecture": {
          "type": "object"
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "data_topology": {
          "type": "object"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dec"
          }
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fm"
          }
        },
        "validation_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sdv"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "required": [
                  "question"
                ],
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blocking": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "traceability": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "relation"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/stable_id"
              },
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/stable_id"
                }
              },
              "relation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "completion_gates": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "FAIL",
              "PENDING",
              "NOT_APPLICABLE"
            ]
          }
        },
        "contract_version": {
          "const": "1.0"
        },
        "design_id": {
          "type": "string",
          "pattern": "^SD-[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "mode": {
          "enum": [
            "interview",
            "production"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "in_progress",
            "validated",
            "complete",
            "blocked"
          ]
        }
      },
      "additionalProperties": false
    },
    "handoff_summary": {
      "type": "string",
      "minLength": 1
    },
    "blocking_questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_recommended_capability": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "validation_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "stable_id": {
      "type": "string",
      "pattern": "^((FR|NFR|ASM|EST|DEC|FM)-[0-9]{3,}|SDV-[A-Z0-9]+(-[A-Z0-9]+)*)$"
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "status",
        "source",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "related_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        }
      },
      "additionalProperties": true
    },
    "fr": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^FR-[0-9]{3,}$"
            },
            "status": {
              "enum": [
                "draft",
                "proposed",
                "accepted",
                "rejected",
                "deferred",
                "superseded"
              ]
            }
          }
        }
      ]
    },
    "nfr": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^NFR-[0-9]{3,}$"
            },
            "status": {
              "enum": [
                "draft",
                "proposed",
                "accepted",
                "needs_measurement",
                "rejected",
                "deferred",
                "superseded"
              ]
            }
          }
        }
      ]
    },
    "asm": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^ASM-[0-9]{3,}$"
            },
            "status": {
              "enum": [
                "provisional",
                "validated",
                "invalidated"
              ]
            }
          }
        }
      ]
    },
    "est": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^EST-[0-9]{3,}$"
            },
            "status": {
              "enum": [
                "draft",
                "accepted",
                "superseded"
              ]
            }
          }
        }
      ]
    },
    "dec": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^DEC-[0-9]{3,}$"
            },
            "status": {
              "enum": [
                "draft",
                "proposed",
                "accepted",
                "rejected",
                "superseded"
              ]
            }
          }
        }
      ]
    },
    "fm": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^FM-[0-9]{3,}$"
            },
            "status": {
              "enum": [
                "draft",
                "accepted",
                "mitigated",
                "superseded"
              ]
            }
          }
        }
      ]
    },
    "sdv": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^SDV-[A-Z0-9]+(-[A-Z0-9]+)*$"
            },
            "status": {
              "enum": [
                "open",
                "resolved",
                "risk_accepted"
              ]
            }
          }
        }
      ]
    }
  }
}
