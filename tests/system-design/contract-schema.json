{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fth-skills.dev/contracts/system-design-state/1.0",
  "title": "System Design State v1",
  "type": "object",
  "required": ["contract_version", "design_id", "mode", "status", "problem", "functional_requirements", "non_functional_requirements", "constraints", "out_of_scope", "assumptions", "estimates", "architecture", "interfaces", "data_topology", "decisions", "failure_modes", "validation_findings", "open_questions", "traceability"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "design_id": {"type": "string", "minLength": 1, "pattern": "^SD-[A-Z0-9-]+$"},
    "mode": {"enum": ["interview", "production"]},
    "status": {"enum": ["draft", "in_progress", "validated", "complete", "blocked"]},
    "problem": {"type": "object", "required": ["summary", "scope", "actors", "source", "confidence"], "additionalProperties": true},
    "functional_requirements": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "non_functional_requirements": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "constraints": {"type": "array"},
    "out_of_scope": {"type": "array"},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "estimates": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "architecture": {"type": "object"},
    "interfaces": {"type": "array"},
    "data_topology": {"type": "object"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "failure_modes": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "validation_findings": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "open_questions": {"type": "array"},
    "traceability": {"type": "array"},
    "completion_gates": {"type": "object"}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "status", "source", "confidence"],
      "properties": {
        "id": {"type": "string"},
        "status": {"type": "string"},
        "source": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "related_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
